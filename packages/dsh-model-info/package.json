{
  "name": "@mzwing/dsh-model-info",
  "version": "0.1.1",
  "description": "Lists third-party models in DeepSeek Harness from their endpoints and completes their metadata from the pi.dev and models.dev catalogs",
  "keywords": [
    "context-window",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "model-metadata",
    "models.dev",
    "pi.dev"
  ],
  "homepage": "https://github.com/mzwing/dsh-plugins/tree/master/packages/dsh-model-info#readme",
  "bugs": {
    "url": "https://github.com/mzwing/dsh-plugins/issues"
  },
  "license": "MIT",
  "author": {
    "name": "mzwing",
    "email": "mzwing@mzwing.eu.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzwing/dsh-plugins.git",
    "directory": "packages/dsh-model-info"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml",
    "config/config.example.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "1.5.0",
    "vitest": "catalog:"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4",
    "node": ">=24"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
